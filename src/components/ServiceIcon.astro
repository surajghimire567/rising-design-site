---
// Line icons matched to the service slugs in migrations/0002. Unknown slugs fall back to the admin-entered symbol.
const { slug = '', fallback = '◈' } = Astro.props as { slug?: string; fallback?: string };
const icons: Record<string, string> = {
  'design-drawing': '<path d="M4 20h16M6 20V9l6-5 6 5v11"/><path d="M10 20v-5h4v5"/><path d="M3 4.5h5M5.5 2v5"/>',
  '3d-interior-design': '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>',
  'estimation-costing': '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M16 11h0M8 15h2M12 15h2M8 18h2M12 18h4"/>',
  'detailed-project-report': '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M9 13h6M9 17h6M9 9h2"/>',
  'surveying': '<path d="M12 3v6M9 6h6"/><circle cx="12" cy="10.5" r="1.5"/><path d="m12 12-5 9M12 12l5 9M12 12v9"/>',
  'site-supervision': '<path d="M4 17h16v2H4z"/><path d="M6 17a6 6 0 0 1 12 0"/><path d="M10 11V7.5a2 2 0 0 1 4 0V11"/>',
};
const path = icons[slug];
---
{path
  ? <svg class="service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={path} />
  : <span class="service-icon service-icon--text" aria-hidden="true">{fallback}</span>}
