---
type Platform = 'whatsapp' | 'viber' | 'facebook' | 'instagram';
const { platform } = Astro.props as { platform: Platform };
---
<svg class={`social-icon social-icon--${platform}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {platform === 'whatsapp' && <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M20.2 11.7a8.2 8.2 0 0 1-12.1 7.2L4 20l1.1-3.7a8.2 8.2 0 1 1 15.1-4.6Z"/><path d="M9 8.3c.2-.4.4-.5.7-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.2.2-.2.4-.1.6.4.7 1.2 1.5 2 1.9.6.3.8.4 1 .1l.7-.8c.2-.2.4-.3.6-.2l1.7.8c.3.1.4.2.4.4 0 .3-.1 1-.5 1.4-.4.4-1 .7-1.6.7-.5 0-1.1-.1-1.8-.4-2.1-.8-3.8-2.4-4.7-4.4-.3-.6-.4-1.2-.3-1.7.1-.5.4-.9.8-1.2Z"/></g>}
  {platform === 'viber' && <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M5.2 4.5c-1.2 1-1.7 2.5-1.6 4.6.2 4.8 4 9.5 9 11.1 1.8.6 3.5.5 4.6-.3l2-1.7-3.2-3.1-2.2 1.2c-2.2-.9-3.8-2.4-4.8-4.5l1.2-2.2-3.1-3.2-1.9 2.1Z"/><path d="M14 5.2c2.6.4 4.5 2.4 4.8 5M14.2 8c1.1.2 1.9 1 2.1 2.1"/><path d="M12.6 3.2c4.7.1 8.2 3.7 8.2 8.3"/></g>}
  {platform === 'facebook' && <path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.8-.1-1.8-.2-2.7-.2-2.8 0-4.6 1.7-4.6 4.7v1.8H6.7V13h2.8v8h4Z"/>}
  {platform === 'instagram' && <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.7" cy="6.5" r=".8" fill="currentColor" stroke="none"/></g>}
</svg>
