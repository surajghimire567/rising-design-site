---
import { socialLinks } from '../lib/data';
import SocialIcon from './SocialIcon.astro';
const visible = socialLinks.filter((social) => social.href);
---
{visible.length > 0 && <ul class="social-links" aria-label="Social media">
  {visible.map((social) => {
    const external = social.href.startsWith('https://');
    return <li><a class={`social-links__item social-links__item--${social.platform}`} href={social.href} aria-label={social.label} title={social.label} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}><SocialIcon platform={social.platform} /></a></li>;
  })}
</ul>}
