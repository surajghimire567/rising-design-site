---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { rows } from '../lib/data';

const people = await rows<any>(env.DB, 'SELECT name,role,bio,photo_key FROM team_members WHERE is_published=1 ORDER BY sort_order');
---
<BaseLayout title="About Rising Design & Construction" description="Learn about Rising Design & Construction and how the team approaches project design and coordination.">
  <section class="page-intro">
    <div class="container page-intro__inner"><p class="eyebrow">About us</p><h1 class="section-title">Engineering with a human perspective</h1><p class="lead">Rising Design &amp; Construction provides design, drawing and construction consultation from Jarankhu, Tarakeshwor, Kathmandu.</p></div>
  </section>
  <section class="section">
    <div class="container content-grid">
      <div><p class="eyebrow">Our approach</p><h2>Clear advice. Practical next steps.</h2><p>Every project begins with listening: understanding your priorities, the site and the decisions ahead. We aim to make technical work easier to follow and next steps easier to act on.</p><a href="/contact" class="text-link">Talk with our team <span aria-hidden="true">→</span></a></div>
      <div class="panel" style="padding: 28px"><p class="eyebrow">How we work</p><ul class="process-list"><li>Understand your brief and priorities</li><li>Develop clear technical options</li><li>Coordinate suitable design and site support</li><li>Keep decisions and next steps visible</li></ul></div>
    </div>
  </section>
  <section class="section section--surface">
    <div class="container">
      <div class="section-heading"><div class="section-heading__copy"><p class="eyebrow">The people behind the work</p><h2 class="section-title">Meet our team</h2></div></div>
      {people.length > 0 ? <div class="team-grid">{people.map((person: any) => <article class="team-card">{person.photo_key ? <img src={`/media/${person.photo_key}`} alt={`Portrait of ${person.name}`} loading="lazy" /> : <div class="team-card__placeholder" aria-hidden="true">◇</div>}<h3>{person.name}</h3><p class="team-card__role">{person.role}</p><p>{person.bio}</p></article>)}</div> : <div class="empty-state" style="margin-top: 28px"><h3>Team profiles are being prepared</h3><p>Contact us to speak with a member of the team about your project.</p></div>}
    </div>
  </section>
</BaseLayout>
