---
import BaseLayout from '../layouts/BaseLayout.astro';
Astro.response.status = 404;
---
<BaseLayout title="Page not found | Rising Design" description="The page you requested could not be found." noIndex={true}>
  <section class="container section">
    <div class="empty-state"><p class="eyebrow">404</p><h1 class="section-title" style="margin-top: 8px">This page could not be found</h1><p>It may have moved, or the address may be incorrect.</p><a class="button" href="/" style="margin-top: 18px">Return to the homepage</a></div>
  </section>
</BaseLayout>
