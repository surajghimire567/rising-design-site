---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { company, rows } from '../lib/data';

const services = await rows<any>(env.DB, 'SELECT id,title,slug,description,icon,short_label FROM services WHERE is_published=1 ORDER BY sort_order LIMIT 3');
const studies = await rows<any>(env.DB, 'SELECT title,slug,summary,cover_image_key FROM case_studies WHERE is_published=1 ORDER BY project_date DESC LIMIT 3');
const testimonials = await rows<any>(env.DB, 'SELECT client_name,company,quote FROM testimonials WHERE is_published=1 ORDER BY created_at DESC LIMIT 2');
---
<BaseLayout title="Engineering Design & Construction Consultation | Rising Design" description="Design, drawing, estimating, surveying and construction consultation for residential and commercial projects in Kathmandu, Nepal.">
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Design · Drawing · Consulting · Construction</p>
        <h1 class="display-title">Design that moves a project <span>forward.</span></h1>
        <p class="lead">From early ideas to site coordination, we help you understand your options and take the next step with a clear plan.</p>
        <div class="button-row" style="margin-top: 26px">
          <a class="button button--accent" href="/contact">Discuss your project <span aria-hidden="true">→</span></a>
          <a class="button button--outline" href="/services">Explore our services</a>
        </div>
        <p class="hero__location">Based in {company.location}</p>
      </div>
      <div class="hero__artwork">
        <img src="/images/company-flyer.png" alt="Rising Design and Construction service overview" width="2086" height="754" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div class="section-heading__copy">
          <p class="eyebrow">How we can help</p>
          <h2 class="section-title">Good projects start with clear thinking.</h2>
        </div>
        <p class="lead">Explore practical support for planning, design, estimates and construction coordination, shaped around your project brief.</p>
      </div>
      {services.length > 0 ? (
        <div class="service-grid">{services.map((service: any) => <ServiceCard service={service} />)}</div>
      ) : (
        <div class="empty-state" style="margin-top: 28px"><h3>Tell us what you are planning</h3><p>Get in touch and we can discuss the right service for your project.</p><a class="button" href="/contact" style="margin-top: 18px">Start a conversation</a></div>
      )}
      <a class="text-link" href="/services" style="margin-top: 22px">View all services <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-heading">
        <div class="section-heading__copy"><p class="eyebrow">Selected work</p><h2 class="section-title">Project stories</h2></div>
        <a class="text-link" href="/case-studies">See all projects <span aria-hidden="true">→</span></a>
      </div>
      {studies.length > 0 ? (
        <div class="project-grid">{studies.map((study: any) => (
          <article class="project-card">
            <a class="project-card__link" href={`/case-studies/${study.slug}`}>
              <div class="project-card__image">{study.cover_image_key ? <img src={`/media/${study.cover_image_key}`} alt={`Project: ${study.title}`} loading="lazy" /> : <span aria-hidden="true">⌂</span>}</div>
              <div class="project-card__copy"><h2>{study.title}</h2><p>{study.summary}</p><span class="text-link">Read project story <span aria-hidden="true">→</span></span></div>
            </a>
          </article>
        ))}</div>
      ) : (
        <div class="empty-state" style="margin-top: 28px"><h3>Project stories are being prepared</h3><p>For information about our experience, please contact the team.</p></div>
      )}
    </div>
  </section>

  {testimonials.length > 0 && <section class="section">
    <div class="container">
      <div class="section-heading"><div class="section-heading__copy"><p class="eyebrow">Client feedback</p><h2 class="section-title">Good work grows from good communication.</h2></div><a class="text-link" href="/testimonials">More client feedback <span aria-hidden="true">→</span></a></div>
      <div class="quote-grid">{testimonials.map((item: any) => <figure class="quote-card"><blockquote>“{item.quote}”</blockquote><figcaption class="quote-card__byline">{item.client_name}{item.company && <span class="quote-card__company">{item.company}</span>}</figcaption></figure>)}</div>
    </div>
  </section>}

  <section class="section section--compact">
    <div class="container"><div class="cta-panel"><p class="eyebrow eyebrow--light">Have a project in mind?</p><h2 class="section-title">Let’s plan the next step.</h2><p>Tell us a little about your project. We’ll follow up to understand your goals and discuss how we can help.</p><a href="/contact" class="button button--accent">Request a consultation</a></div></div>
  </section>
</BaseLayout>
