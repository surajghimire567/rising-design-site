---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { rows } from '../../lib/data';

const result = await rows<any>(env.DB, 'SELECT c.*,s.title AS service_title FROM case_studies c LEFT JOIN services s ON s.id=c.service_id WHERE c.slug=? AND c.is_published=1 LIMIT 1', Astro.params.slug ?? '');
const study = result[0];
if (!study) Astro.response.status = 404;
const paragraphs = study ? String(study.body ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : [];
const dateLabel = study?.project_date ? new Date(`${study.project_date}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
---
<BaseLayout title={study ? `${study.title} | Rising Design Projects` : 'Project not found | Rising Design'} description={study?.summary || 'This project could not be found.'} noIndex={!study} image={study?.cover_image_key ? `/media/${study.cover_image_key}` : undefined}>
  {study ? (
    <>
      <section class="page-intro page-intro--article">
        <div class="container page-intro__inner">
          <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/case-studies">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{study.title}</span></nav>
          <p class="eyebrow eyebrow--light">{study.service_title || 'Project'}</p>
          <h1 class="section-title">{study.title}</h1>
          <p class="lead">{study.summary}</p>
          <dl class="meta-row">
            {study.service_title && <div><dt>Service</dt><dd>{study.service_title}</dd></div>}
            {dateLabel && <div><dt>Date</dt><dd>{dateLabel}</dd></div>}
          </dl>
        </div>
      </section>
      <article class="container section article">
        {study.cover_image_key && <img class="article__image" src={`/media/${study.cover_image_key}`} alt={`${study.title} project`} decoding="async" />}
        <div class="article__body">{paragraphs.map((p) => <p>{p}</p>)}</div>
        <div class="article__actions">
          {study.pdf_attachment_key && <a class="button button--outline" href={`/media/${study.pdf_attachment_key}`}>Download project PDF <span aria-hidden="true">↓</span></a>}
          <a href="/case-studies" class="text-link">← Back to all projects</a>
        </div>
      </article>
      <CtaBanner title="Planning something similar?" />
    </>
  ) : (
    <section class="container section"><div class="empty-state"><span class="empty-state__icon" aria-hidden="true">⌂</span><h1>Project not found</h1><p>This project may have been removed or is no longer published.</p><a class="button" href="/case-studies">Browse projects</a></div></section>
  )}
</BaseLayout>
