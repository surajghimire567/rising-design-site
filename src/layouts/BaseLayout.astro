---
import '../styles/global.css';
import { company, whatsappChatUrl } from '../lib/data';
import SocialIcon from '../components/SocialIcon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { env } from 'cloudflare:workers';

const {
  title = company.shortName,
  description = 'Engineering design, drawing and construction consultation in Jarankhu, Tarakeshwor, Kathmandu, Nepal.',
  canonical = '',
  noIndex = false,
} = Astro.props;
const siteUrl = (env.SITE_URL || Astro.site?.toString() || 'https://example.com').replace(/\/+$/, '');
const pageUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  url: siteUrl,
  telephone: company.phones.map((phone) => phone.display),
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jarankhu, Tarakeshwor',
    addressLocality: 'Kathmandu',
    addressCountry: 'NP',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${siteUrl}/images/company-flyer.png`} />
    <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#102846" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/rising-logo.png" />
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />
    <script is:inline src="/scripts/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="brand" aria-label={`${company.shortName} home`}>
          <img src="/images/rising-logo.png" alt="" width="54" height="58" />
          <strong class="brand__name">{company.shortName}</strong>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/services">Services</a>
          <a href="/case-studies">Projects</a>
          <a href="/testimonials">Testimonials</a>
          <a href="/about">About</a>
          <a href="/contact" class="button">Request a consultation</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Open navigation">Menu</summary>
          <nav class="mobile-nav__panel" aria-label="Mobile navigation">
            <a href="/">Home</a>
            <a href="/services">Services</a>
            <a href="/case-studies">Projects</a>
            <a href="/testimonials">Testimonials</a>
            <a href="/about">About</a>
            <a href="/contact">Request a consultation</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div>
          <h2>{company.shortName}</h2>
          <p>Design and construction consultation grounded in clear communication and practical project support.</p>
          <h3 class="site-footer__social-title">Follow us</h3>
          <SocialLinks />
        </div>
        <div>
          <h3>Get in touch</h3>
          {company.phones.map((phone) => <a class="site-footer__phone" href={`tel:+${phone.number}`}><span>{phone.label}</span><strong>{phone.display}</strong></a>)}
          <a href={`mailto:${company.email}`}>{company.email}</a>
          <p>{company.location}</p>
        </div>
        <div>
          <h3>Explore</h3>
          <a href="/">Home</a>
          <a href="/services">Services</a>
          <a href="/case-studies">Projects</a>
          <a href="/contact">Consultation request</a>
        </div>
      </div>
      <div class="site-footer__bottom"><div class="container">© {new Date().getFullYear()} {company.shortName}. All rights reserved.</div></div>
    </footer>
    <a class="whatsapp-fab" href={whatsappChatUrl} target="_blank" rel="noopener noreferrer" aria-label={`Chat with ${company.shortName} on WhatsApp`}>
      <span class="whatsapp-fab__icon"><SocialIcon platform="whatsapp" /></span>
      <span class="whatsapp-fab__copy"><span class="whatsapp-fab__eyebrow">Need help with a project?</span><strong>Chat on WhatsApp</strong></span>
      <span class="whatsapp-fab__arrow" aria-hidden="true">↗</span>
    </a>
  </body>
</html>
