{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rising-design-site",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"COMPANY_NAME": "Rising Design and Construction Pvt. Ltd.",
		"NOTIFICATION_EMAIL": "risingdesignandconstruction@gmail.com",
		"RESEND_FROM": "Rising Design <website@risingdesign.com.np>",
		"MAX_UPLOAD_BYTES": "5242880",
		"SITE_URL": "https://risingdesign.com.np"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rising_design_db",
			"database_id": "f15329a8-ceb2-4485-b740-58e06f9b31a8",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "rising-design-media"
		}
	]
}